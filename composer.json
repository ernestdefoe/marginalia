{
    "name": "ernestdefoe/marginalia",
    "description": "Marginalia — highlight a passage in a post. Keep it to yourself with a note, or mark it publicly: the sentences people keep marking glow.",
    "type": "flarum-extension",
    "keywords": ["flarum", "highlights", "annotations", "notes"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39848-marginalia-highlight-a-passage-privately-or-publicly-built-using-ai"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Marginalia\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Marginalia",
            "category": "feature",
            "icon": {
                "name": "fas fa-highlighter",
                "backgroundColor": "#d97706",
                "color": "#fff"
            }
        }
    }
}
